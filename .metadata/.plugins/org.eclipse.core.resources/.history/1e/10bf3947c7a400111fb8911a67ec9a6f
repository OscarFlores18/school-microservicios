server:
  port: 8080

spring:
  application:
    name: gateway

  cloud:
    gateway:
      server:
        webmvc:
          routes:

            # ========================================
            # API - ALUMNOS
            # ========================================
            - id: alumnos
              uri: lb://MS-ALUMNOS
              predicates:
                - Path=/api/alumnos/**

            # ========================================
            # API - ADMINISTRACION
            # ========================================
            - id: docentes
              uri: lb://MS-ADMINISTRACION
              predicates:
                - Path=/api/docentes/**

            # ========================================
            # API - CURSOS
            # ========================================
            - id: cursos
              uri: lb://MS-CURSOS
              predicates:
                - Path=/api/cursos/**


            # ========================================
            # SWAGGER - ADMINISTRACION
            # ========================================
            - id: swagger-administracion-ui
              uri: lb://MS-ADMINISTRACION
              predicates:
                - Path=/administracion/swagger-ui/**
              filters:
                - StripPrefix=1

            - id: swagger-administracion-api
              uri: lb://MS-ADMINISTRACION
              predicates:
                - Path=/administracion/v3/api-docs/**
              filters:
                - StripPrefix=1


            # ========================================
            # SWAGGER - ALUMNOS
            # ========================================
            - id: swagger-alumnos-ui
              uri: lb://MS-ALUMNOS
              predicates:
                - Path=/alumnos/swagger-ui/**
              filters:
                - StripPrefix=1

            - id: swagger-alumnos-api
              uri: lb://MS-ALUMNOS
              predicates:
                - Path=/alumnos/v3/api-docs/**
              filters:
                - StripPrefix=1


            # ========================================
            # SWAGGER - CURSOS
            # ========================================
            - id: swagger-cursos-ui
              uri: lb://MS-CURSOS
              predicates:
                - Path=/cursos/swagger-ui/**
              filters:
                - StripPrefix=1

            - id: swagger-cursos-api
              uri: lb://MS-CURSOS
              predicates:
                - Path=/cursos/v3/api-docs/**
              filters:
                - StripPrefix=1


# ========================================
# EUREKA
# ========================================
eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/

  instance:
    lease-renewal-interval-in-seconds: 10
